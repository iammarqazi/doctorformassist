# Copy to .env and fill in your values — .env is gitignored

# Your UPI ID (shown on landing page + embedded in QR code)
VITE_UPI_ID=yourname@upi

# Your name as it appears in UPI payment screen
VITE_UPI_NAME=DoctorFormAssist

# Your WhatsApp number: country code + number, no + or spaces
# India example: 919812345678
VITE_WHATSAPP=919999999999
